+def _error_cell_text(terminal_id: str) -> str:
+    """Return ": <text>" of this turn's "■" error cell on the pane (Codex usage limit), or ""."""
+    lines = strip_terminal_escapes(terminal_service.get_output_context(terminal_id) or "").splitlines()
+    users = [i for i, line in enumerate(lines) if re.match(r"[›»]\s*\S", line)]
+    if users and sum(1 for line in lines[users[-1] + 1 :] if line.strip()) <= 1:
+        users.pop()  # the trailing composer ("› Ask Codex"), not a user message
+    start = users[-1] + 1 if users else 0
+    cell = [i for i in range(start, len(lines)) if re.match(r"■\s", lines[i])]
+    if not cell:
+        return ""
+    text = []
+    for line in lines[cell[-1] :]:
+        if text and (not line.strip() or line[0] in "›•─"):
+            break
+        text.append(line)
+    return ": " + re.sub(r"\s+", " ", " ".join(text))[:500]
