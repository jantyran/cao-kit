+    def _rollout_path(self) -> Optional[Path]:
+        """Return the single main rollout open in this pane's Codex processes."""
+        pid = self._rollout_shell_pid()
+        if pid is None:
+            return None
+        paths = set()
+        for path in _codex_rollout_paths(pid):
+            with path.open("rb") as stream:
+                row = json.loads(stream.readline(64 * 1024))
+            if not isinstance(row, dict) or row.get("type") != "session_meta":
+                return None
+            meta = row.get("payload")
+            if not isinstance(meta, dict) or not isinstance(meta.get("id"), str) or not meta["id"]:
+                return None
+            if "parent_thread_id" in meta or meta["id"] != meta.get("session_id"):
+                continue  # automatic approval conversations are not worker answers
+            paths.add(path)
+        if len(paths) != 1:
+            return None
+        return paths.pop()
+
+    def _last_rollout_answer(self) -> Optional[str]:
+        """Read only complete post-send records, with a 4 MiB ceiling."""
+        with self._dispatch_lock:
+            dispatch_id = self._logical_dispatch_id
+            dispatched = self._rollout_dispatch_message
+            boundary = self._rollout_dispatch_boundary
+        if boundary is None or not dispatched or not dispatched.strip():
+            return None
+        expected = " ".join(dispatched.split())
+        try:
+            path, device, inode, offset, digest = boundary
+            if self._rollout_path() != path:
+                return None
+            with path.open("rb") as stream:
+                stat = os.fstat(stream.fileno())
+                if (stat.st_dev, stat.st_ino) != (device, inode):
+                    return None
+                length = stat.st_size - offset
+                # ponytail: if the boundary falls outside the 4 MiB tail, use the screen.
+                if length <= 0 or length > 4 * 1024 * 1024:
+                    return None
+                stream.seek(max(0, offset - 4096))
+                if hashlib.sha256(stream.read(min(offset, 4096))).digest() != digest:
+                    return None  # same inode may have been truncated and rewritten
+                stream.seek(offset)
+                lines = stream.read(length).splitlines(keepends=True)
+            answer = None
+            matched = False
+            for line in lines:
+                if not line.endswith(b"\n"):
+                    continue  # an unfinished record may still be growing
+                try:
+                    row = json.loads(line)
+                    if not isinstance(row, dict) or row.get("type") != "response_item":
+                        continue
+                    payload = row.get("payload")
+                    if not isinstance(payload, dict) or payload.get("type") != "message":
+                        continue
+                    if payload.get("role") == "user":
+                        answer = None
+                        matched = False
+                        text = "".join(item["text"] for item in payload["content"]
+                                       if item.get("type") == "input_text")
+                        text = " ".join(text.split())
+                        # Compare the complete request, allowing CAO's appended callback.
+                        matched = text == expected or text.startswith(expected + " [Assigned by terminal ")
+                        continue
+                    if payload.get("role") != "assistant" or payload.get("phase") not in (None, "final", "final_answer"):
+                        continue
+                    if not matched:
+                        continue
+                    text = "".join(item["text"] for item in payload["content"]
+                                   if item.get("type") == "output_text")
+                    answer = text if text.strip() else None
+                except (ValueError, TypeError, KeyError, AttributeError):
+                    continue  # malformed/truncated records do not poison the tail
+            with self._dispatch_lock:
+                if (self._logical_dispatch_id != dispatch_id
+                        or self._rollout_dispatch_message != dispatched
+                        or self._rollout_dispatch_boundary is not boundary):
+                    return None
+            return answer
+        except Exception:
+            logger.debug("Codex rollout unavailable; using screen extraction", exc_info=True)
+            return None
+
