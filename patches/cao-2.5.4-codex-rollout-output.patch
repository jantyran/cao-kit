+    def _rollout_shell_pid(self) -> Optional[int]:
+        """Resolve this terminal's shell, never an unscoped foreground process."""
+        from cli_agent_orchestrator.backends.base import TerminalBackendError
+        from cli_agent_orchestrator.backends.herdr_backend import HerdrBackend, _sanitize_herdr_args
+        from cli_agent_orchestrator.backends.tmux_backend import TmuxBackend
+
+        deadline = time.monotonic() + 2.0
+
+        def run(cmd):
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                raise subprocess.TimeoutExpired(cmd, 2.0)
+            return subprocess.run(cmd, capture_output=True, text=True, timeout=remaining)
+
+        backend = get_backend()
+        if isinstance(backend, HerdrBackend):
+            # Keep shared backend settings untouched; bound every resolution call.
+            backend = copy.copy(backend)
+
+            def run_herdr(args, check=True):
+                result = run(["herdr", "--session", backend.herdr_session]
+                             + _sanitize_herdr_args(args))
+                if check and result.returncode:
+                    raise TerminalBackendError("Codex rollout pane lookup failed")
+                return result
+
+            backend._run_herdr = run_herdr
+            pane = backend._resolve_pane_id_from_window(self.session_name, self.window_name)
+            result = backend._run_herdr(["pane", "process-info", "--pane", pane], check=False)
+            if result.returncode:
+                return None
+            pid = backend._parse_herdr_json(result.stdout)["process_info"]["shell_pid"]
+        elif isinstance(backend, TmuxBackend):
+            from cli_agent_orchestrator.clients.tmux import TERMINAL_MARK_OPTION
+            from cli_agent_orchestrator.utils.terminal import validate_tmux_name
+
+            server = backend._client.server
+            command = ["tmux"]
+            for flag, value in (("-f", server.config_file), ("-S", server.socket_path),
+                                ("-L", server.socket_name)):
+                if value:
+                    command.extend([flag, str(value)])
+            session = validate_tmux_name(self.session_name, "session_name")
+            result = run(command + ["list-panes", "-s", "-t", "=" + session, "-F",
+                                    "#{window_name}\t#{pane_id}\t#{pane_active}\t#{pane_pid}"])
+            if result.returncode:
+                return None
+            rows = [line.split("\t") for line in result.stdout.splitlines()]
+            if any(len(row) != 4 for row in rows):
+                return None
+            named = [row for row in rows if row[0] == self.window_name]
+            if named:
+                matches = [row[3] for row in named if row[2] == "1"]
+            else:
+                matches = []
+                for _, pane_id, _, pane_pid in rows:
+                    result = run(command + ["show-options", "-p", "-t", pane_id])
+                    if result.returncode:
+                        return None
+                    # Read the pane's own mark, not an inherited window option.
+                    if f"{TERMINAL_MARK_OPTION} {self.window_name}" in result.stdout.splitlines():
+                        matches.append(pane_pid)
+            if len(matches) != 1:
+                return None
+            pid = matches[0]
+        else:
+            return None
+        pid = int(pid)
+        return pid if pid > 0 else None
