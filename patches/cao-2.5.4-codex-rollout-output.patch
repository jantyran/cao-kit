+def _codex_rollout_paths(shell_pid: int, *, proc_root: Path = Path("/proc"),
+                         sessions_root: Optional[Path] = None) -> set[Path]:
+    """Find open rollouts belonging only to Codex descendants of this pane."""
+    if sessions_root is None:
+        sessions_root = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex"))) / "sessions"
+    paths: set[Path] = set()
+    pending = [shell_pid]
+    seen: set[int] = set()
+    try:
+        sessions_root = sessions_root.resolve()
+        while pending:
+            pid = pending.pop()
+            if pid in seen:
+                continue
+            seen.add(pid)
+            process = proc_root / str(pid)
+            # Children may have been spawned by any thread in the process.
+            for task in (process / "task").iterdir():
+                pending.extend(int(child) for child in (task / "children").read_text().split())
+            if (process / "exe").readlink().name != "codex":
+                continue
+            for fd in (process / "fd").iterdir():
+                try:
+                    target = fd.readlink()
+                except FileNotFoundError:  # descriptor closed during the scan
+                    continue
+                if target.name.startswith("rollout-") and target.suffix == ".jsonl":
+                    target = target.resolve()
+                    if target.is_relative_to(sessions_root):
+                        paths.add(target)
+    except (OSError, ValueError):
+        # An incomplete scan cannot establish that the candidate is unique.
+        return set()
+    return paths
+
 
