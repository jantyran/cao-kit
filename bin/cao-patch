#!/usr/bin/env python3
"""Apply the bundled CAO 2.5.4 herdr pane patch; --check reports, --reverse removes.

Exit status: 0 applied/removed, 1 not applied (--check), 2 unavailable/incompatible.
"""
from pathlib import Path
import shutil
import json
import subprocess
import sys


def main(args):
    if args not in ([], ['--check'], ['--reverse']):
        print(__doc__)
        return 0 if args in (['--help'], ['-h']) else 2
    cao = shutil.which('cao')
    if not cao or not shutil.which('patch'):
        print('適用できません: cao と patch コマンドが必要です。', file=sys.stderr)
        return 2
    python = Path(cao).resolve().parent / 'python'
    patchfile = Path(__file__).resolve().parents[1] / 'patches/cao-2.5.4-herdr-pane-spawn.patch'
    try:
        located = subprocess.run(
            [str(python), '-c', 'import json, cli_agent_orchestrator, importlib.metadata as m; from pathlib import Path; print(json.dumps([str(Path(cli_agent_orchestrator.__file__).parent), m.version("cli-agent-orchestrator")]))'],
            capture_output=True, text=True, timeout=20, check=True,
        )
        package_path, version = json.loads(located.stdout.strip())
        if version != '2.5.4':
            print(f'適用できません: CAO version {version} は対象外です（必要: 2.5.4）。', file=sys.stderr)
            return 2
        root = Path(package_path)
        if not root.is_absolute() or not (root / 'backends/herdr_backend.py').is_file():
            raise ValueError('CAO パッケージの場所を確認できません')
        command = ['patch', '--batch', '--silent', '--no-backup-if-mismatch', '--reject-file=-', '-F0', '-p1', '-i', str(patchfile)]
        def run(*options):
            return subprocess.run(command + list(options), cwd=root, text=True, capture_output=True, timeout=20)
        if run('--dry-run', '--reverse', '--forward').returncode == 0:
            if args == ['--reverse']:
                reversed_patch = run('--reverse', '--forward')
                if reversed_patch.returncode:
                    print('逆適用できません:\n' + reversed_patch.stdout + reversed_patch.stderr, file=sys.stderr)
                    return 2
                print('逆適用しました: CAO 2.5.4 herdr pane spawn（cao-server の再起動は行いません）')
                return 0
            print('適用済み: CAO 2.5.4 herdr pane spawn')
            return 0
        pending = run('--dry-run', '--forward')
        if pending.returncode != 0:
            print('適用できません: インストール済み CAO とパッチが一致しません。\n' + pending.stdout + pending.stderr, file=sys.stderr)
            return 2
        if args == ['--reverse']:
            print('逆適用済み（未適用）: CAO 2.5.4 herdr pane spawn')
            return 0
        if args == ['--check']:
            print('未適用: cao-patch を実行してください。')
            return 1
        applied = run('--forward')
        if applied.returncode != 0:
            print('適用できません:\n' + applied.stdout + applied.stderr, file=sys.stderr)
            return 2
        print('適用しました: CAO 2.5.4 herdr pane spawn（cao-server の再起動は行いません）')
        return 0
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        print(f'適用できません: {exc}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
