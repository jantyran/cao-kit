#!/usr/bin/env python3
"""Apply the bundled CAO 2.5.4 patches; --check reports, --reverse removes.

Exit status: 0 applied/removed, 1 not applied (--check), 2 unavailable/incompatible.
"""
from pathlib import Path
import shutil
import json
import subprocess
import sys


def main(args):
    if args not in ([], ['--check'], ['--reverse']):
        print(__doc__)
        return 0 if args in (['--help'], ['-h']) else 2
    cao = shutil.which('cao')
    if not cao or not shutil.which('patch'):
        print('適用できません: cao と patch コマンドが必要です。', file=sys.stderr)
        return 2
    python = Path(cao).resolve().parent / 'python'
    try:
        located = subprocess.run(
            [str(python), '-c', 'import json, cli_agent_orchestrator, importlib.metadata as m; from pathlib import Path; print(json.dumps([str(Path(cli_agent_orchestrator.__file__).parent), m.version("cli-agent-orchestrator")]))'],
            capture_output=True, text=True, timeout=20, check=True,
        )
        package_path, version = json.loads(located.stdout.strip())
        if version != '2.5.4':
            print(f'適用できません: CAO version {version} は対象外です（必要: 2.5.4）。', file=sys.stderr)
            return 2
        root = Path(package_path)
        if not root.is_absolute() or not (root / 'backends/herdr_backend.py').is_file():
            raise ValueError('CAO パッケージの場所を確認できません')
        patchfiles = sorted((Path(__file__).resolve().parents[1] / 'patches').glob(f'cao-{version}-*.patch'))
        if not patchfiles:
            raise ValueError('対象のパッチがありません')
        def run(patchfile, *options):
            command = ['patch', '--batch', '--silent', '--no-backup-if-mismatch', '--reject-file=-', '-F0', '-p1', '-i', str(patchfile)]
            return subprocess.run(command + list(options), cwd=root, text=True, capture_output=True, timeout=20)
        states = []
        for patchfile in patchfiles:
            applied = run(patchfile, '--dry-run', '--reverse', '--forward').returncode == 0
            if not applied:
                pending = run(patchfile, '--dry-run', '--forward')
                if pending.returncode:
                    print('適用できません: インストール済み CAO とパッチが一致しません。\n' + pending.stdout + pending.stderr, file=sys.stderr)
                    return 2
            states.append((patchfile, applied))
        if args == ['--reverse']:
            states.reverse()
        missing = False
        applied_this_run = []
        for patchfile, applied in states:
            label = patchfile.stem
            if args == ['--check']:
                print(('適用済み: ' if applied else '未適用: ') + label)
                missing |= not applied
            elif args == ['--reverse']:
                if applied:
                    result = run(patchfile, '--reverse', '--forward')
                    if result.returncode:
                        print('逆適用できません:\n' + result.stdout + result.stderr, file=sys.stderr)
                        return 2
                print(('逆適用しました: ' if applied else '逆適用済み（未適用）: ') + label)
            elif applied:
                print('適用済み: ' + label)
            else:
                result = run(patchfile, '--forward')
                if result.returncode:
                    print('適用できません:\n' + result.stdout + result.stderr, file=sys.stderr)
                    for rolled in reversed(applied_this_run):
                        if run(rolled, '--reverse').returncode:
                            print(f'元に戻せませんでした: {rolled.stem}。cao-patch --reverse を実行してください。', file=sys.stderr)
                        else:
                            print(f'元に戻しました: {rolled.stem}', file=sys.stderr)
                    return 2
                applied_this_run.append(patchfile)
                print('適用しました: ' + label + '（cao-server の再起動は行いません）')
        return 1 if missing else 0
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        print(f'適用できません: {exc}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
