#!/usr/bin/env bash
# cao-dev: <プロジェクト置き場>/<project> で Claude(リーダー) + Codex(実装) + agy(調査・文章) の CAO セッションを起動
#   cao-dev                           プロジェクト置き場（CAO_DEV_ROOT、既定 ~/projects）の中なら、そのプロジェクトで起動
#   cao-dev（プロジェクトの外）  開いているセッションの画面（herdr）に入る
#   cao-dev <project>                 対話モード（置き場になければ ~/<project> も探す）
#   cao-dev <パス>                     置き場の外でも、パス（. や ~/foo、/path/to/foo）で指定できる
#   cao-dev <project> "<依頼内容>"     ヘッドレスで依頼を投げて非同期実行
#   cao-dev --lead agy_opus_lead [project]   リーダーを予備に差し替えて起動
#   cao-dev -l | --list               プロジェクト一覧
set -euo pipefail
# 個人設定は cao-trio 直下の local.env（git 管理外）。環境変数があればそちらを優先
env_root=${CAO_DEV_ROOT:-} env_lead=${CAO_DEV_LEAD:-}
kit=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd -P)
[[ -f "$kit/local.env" ]] && . "$kit/local.env"
ROOT="${env_root:-${CAO_DEV_ROOT:-$HOME/projects}}"
PROFILE="${env_lead:-${CAO_DEV_LEAD:-claude_opus_lead}}"

usage() { sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; }
ensure_server() {
  # cao-server が止まっていれば systemd で起動して、最大 15 秒待つ
  if ! curl -sf http://localhost:9889/health >/dev/null; then
    echo "cao-server を起動します…" >&2
    systemctl --user start cao-server.service 2>/dev/null || true
    for _ in $(seq 15); do curl -sf http://localhost:9889/health >/dev/null && break; sleep 1; done
    curl -sf http://localhost:9889/health >/dev/null || {
      echo "cao-server が起動できません。journalctl --user -u cao-server -n 30 で原因を確認してください。" >&2; exit 1; }
  fi
}
# --lead <profile> でリーダーを差し替え（利用上限時: agy_opus_lead → codex_sol_lead）
if [[ "${1:-}" == "--lead" ]]; then
  [[ -n "${2:-}" ]] || { echo "--lead にプロファイル名を指定してください（例: agy_opus_lead）" >&2; exit 1; }
  PROFILE="$2"; shift 2
fi

# 引数なしなら、置き場の配下はそのプロジェクト、他のリポジトリはそのルート、それ以外は既存セッション
if [[ $# -eq 0 ]]; then
  attach_existing=0
  case "$PWD/" in
    "$ROOT"/*/*) set -- "$(echo "${PWD#$ROOT/}" | cut -d/ -f1)" ;;
    *)
      top=$(git rev-parse --show-toplevel 2>/dev/null || true)
      if [[ -n "$top" && "$top" != "$HOME" && "$top" != / ]]; then
        set -- "$top"
      else
        attach_existing=1
      fi
      ;;
  esac
fi
case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  -l|--list) ls -1d "$ROOT"/*/ | xargs -n1 basename | grep -v '^z_archived$'; exit 0 ;;
esac

if [[ "${attach_existing:-0}" == 1 ]]; then
  ensure_server
  sessions=$(cao session list 2>/dev/null | awk '$1 ~ /^cao-/ {print $1}')
  [[ -n "$sessions" ]] || { usage; exit 0; }
  printf '%s\n' "$sessions"
  BACKEND="$(cao config get terminal.backend 2>/dev/null | tr -d '"')"
  HERDR_SESSION="$(cao config get terminal.herdr_session 2>/dev/null | tr -d '"')"; HERDR_SESSION="${HERDR_SESSION:-cao}"
  if [[ -n "${HERDR_PANE_ID:-}${TMUX:-}" ]]; then
    if [[ -n "${HERDR_PANE_ID:-}" ]]; then
      echo "すでに herdr の中です。ワークスペース一覧から選んでください。"
    else
      echo "すでに tmux の中です。tmux のセッション一覧（Ctrl-b s）から選んでください。"
    fi
    exit 0
  fi
  if [[ "$BACKEND" == herdr ]]; then exec herdr --session "$HERDR_SESSION"; fi
  exec tmux attach
fi

arg="$1"; shift
# / を含むか . ならパス、それ以外は置き場 → ホーム直下の順で探す
case "$arg" in
  .|..|*/*) dir="$arg" ;;
  *) dir="$ROOT/$arg"; [[ -d "$dir" ]] || [[ ! -d "$HOME/$arg" ]] || dir="$HOME/$arg" ;;
esac
[[ -d "$dir" ]] || { echo "プロジェクトが見つかりません: $arg" >&2; echo "候補（$ROOT）:" >&2; if [[ -d "$ROOT" ]]; then find "$ROOT" -mindepth 1 -maxdepth 1 -type d -printf "  %f\n" >&2; else echo "  候補を表示できません。" >&2; fi; exit 1; }
dir=$(cd -- "$dir" && pwd -P)
proj=$(basename -- "$dir")
[[ "$dir" != "$HOME" && "$dir" != / ]] || { echo "ホームや / そのものでは起動できません。プロジェクトのフォルダを指定してください。" >&2; exit 1; }

# Codex の「Trust this folder?」ダイアログでタスク配送が失敗するのを防ぐ
CODEX_CFG="$HOME/.codex/config.toml"
if [[ -f "$CODEX_CFG" ]] && ! grep -qF "[projects.\"$dir\"]" "$CODEX_CFG"; then
  printf '\n[projects."%s"]\ntrust_level = "trusted"\n' "$dir" >> "$CODEX_CFG"
  echo "Codex trust に追加: $dir"
fi

# 指示書置き場 .cao/ を git の差分に出さない（ローカル除外のみ・コミットされない）
exclude=$(git -C "$dir" rev-parse --path-format=absolute --git-path info/exclude 2>/dev/null) || exclude=''
if [[ -n "$exclude" ]] && ! grep -qxF '.cao/' "$exclude" 2>/dev/null; then
  echo '.cao/' >> "$exclude"
fi

ensure_server
# 前回うまく動いたときから CLI が更新されていれば知らせる（止めはしない）
command -v cao-doctor >/dev/null && { cao-doctor --brief >&2 || true; }

# 端末バックエンド（cao config set terminal.backend tmux|herdr）
BACKEND="$(cao config get terminal.backend 2>/dev/null | tr -d '"')"
HERDR_SESSION="$(cao config get terminal.herdr_session 2>/dev/null | tr -d '"')"; HERDR_SESSION="${HERDR_SESSION:-cao}"

# 多重化端末の内側からは切り替え、外からは attach
attach_or_switch() {
  if [[ "$BACKEND" == herdr ]]; then
    local ws
    ws=$(herdr --session "$HERDR_SESSION" workspace list | jq -r --arg n "$1" '.result.workspaces[] | select(.label==$n) | .workspace_id' | head -1)
    [[ -n "$ws" ]] || { echo "herdr ワークスペースが見つかりません: $1" >&2; exit 1; }
    herdr --session "$HERDR_SESSION" workspace focus "$ws" >/dev/null
    [[ -n "${HERDR_PANE_ID:-}" ]] && exit 0  # herdr 内なら focus だけで切り替わる
    exec herdr --session "$HERDR_SESSION"
  fi
  if [[ -n "${TMUX:-}" ]]; then exec tmux switch-client -t "$1"; else exec tmux attach -t "$1"; fi
}

suffix=""; [[ "$PROFILE" != "claude_opus_lead" ]] && suffix="-${PROFILE%%_*}"
# セッション名は cao-<プロジェクト名>（CAO が cao- を付ける）
name="$(echo "$proj" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9\n-' '-')$suffix"
sess="cao-${name#cao-}"
# 明確にシェルへ戻った場合だけ終了と判定する。
leader_exited() {
  local session_data terminal window status retry=${1:-1}
  session_data=$(curl -sf "http://localhost:9889/sessions/$sess") || return 1
  terminal=$(jq -ec '[.terminals[] | select((.agent_profile // "") | endswith("_lead"))][0] // .terminals[0] | select(type == "object")' <<< "$session_data") || return 1
  window=$(jq -er '.tmux_window | select(type == "string" and length > 0)' <<< "$terminal") || return 1
  status=$(jq -er '.status | select(type == "string" and length > 0)' <<< "$terminal") || return 1
  if [[ "$BACKEND" == herdr ]]; then
    local workspaces ws tabs tab panes state
    workspaces=$(herdr --session "$HERDR_SESSION" workspace list) || return 1
    ws=$(jq -er --arg n "$sess" '[.result.workspaces[] | select(.label == $n) | .workspace_id] | if length == 0 then "missing" elif length == 1 then .[0] else error("ambiguous") end' <<< "$workspaces") || return 1
    if [[ "$ws" == missing ]]; then
      [[ "$status" == unknown ]] || return 1
      [[ "$retry" == 1 ]] || return 0
      sleep 1
      leader_exited 0
      return
    fi
    tabs=$(herdr --session "$HERDR_SESSION" tab list) || return 1
    tab=$(jq -er --arg ws "$ws" --arg window "$window" '[.result.tabs[] | select(.workspace_id == $ws and .label == $window) | .tab_id] | if length == 0 then "missing" elif length == 1 then .[0] else error("ambiguous") end' <<< "$tabs") || return 1
    if [[ "$tab" == missing ]]; then
      [[ "$status" == unknown ]] || return 1
      [[ "$retry" == 1 ]] || return 0
      sleep 1
      leader_exited 0
      return
    fi
    panes=$(herdr --session "$HERDR_SESSION" pane list) || return 1
    state=$(jq -er --arg ws "$ws" --arg tab "$tab" '
      [.result.panes[] | select(.workspace_id == $ws and .tab_id == $tab and ((.label // "") == ""))] |
      if length == 0 then "unknown"
      elif any(.[]; (.agent // "") != "") then "live"
      elif all(.[]; (.terminal_title // "") | test("^[^[:space:]@]+@[^[:space:]:]+:")) then "shell"
      else "unknown" end
    ' <<< "$panes") || return 1
    [[ "$state" == shell && "$status" == unknown ]]
  elif [[ "$BACKEND" == tmux ]]; then
    local commands command
    [[ "$status" == unknown ]] || return 1
    commands=$(tmux list-panes -t "$sess:$window" -F '#{pane_current_command}' 2>/dev/null) || return 1
    [[ -n "$commands" ]] || return 1
    while IFS= read -r command; do
      [[ "$command" == bash || "$command" == zsh || "$command" == sh ]] || return 1
    done <<< "$commands"
    return 0
  else
    return 1
  fi
}
restarting=0
if cao session list 2>/dev/null | grep -q "^$sess\b"; then
  # 同じ名前の別フォルダのプロジェクトに誤って接続しないよう、作業フォルダを確かめる
  other=$(curl -sf "http://localhost:9889/sessions/$sess" | python3 -c 'import json,sys; t=json.load(sys.stdin)["terminals"]; print(t[0]["working_directory"] if t else "")' || true)
  if [[ -n "$other" && "$other" != "$dir" ]]; then
    echo "セッション $sess は別のフォルダ（$other）で動いています。そちらを止めるか、フォルダ名を変えてください。" >&2; exit 1
  fi
  if leader_exited; then
    echo "リーダーが終了しています。片付けて起動し直します。" >&2
    if [[ "${CAO_DEV_RESTART:-}" != 1 && -n "${TMUX:-}${HERDR_PANE_ID:-}" ]]; then
      mkdir -p "$dir/.cao/tmp"
      CAO_DEV_RESTART=1 setsid nohup "$kit/bin/cao-dev" --lead "$PROFILE" "$dir" "$@" >"$dir/.cao/tmp/cao-dev-restart.log" 2>&1 < /dev/null &
      exit 0
    fi
    cao shutdown --session "$sess"
    restarting=1
  else
    echo "既存セッション $sess があります。" >&2
    if [[ $# -gt 0 ]]; then exec cao session send "$sess" "$*" --async; fi
    attach_or_switch "$sess"
  fi
fi

"$kit/bin/cao-recap" "$dir" || true

if [[ $# -gt 0 ]]; then
  cao launch --agents "$PROFILE" --session-name "$name" --working-directory "$dir" \
    --headless --auto-approve --async "$*"
  echo "状況確認: cao session status $sess --workers / 接続: cao-dev $arg"
  [[ "$restarting" != 1 ]] || attach_or_switch "$sess"
else
  if [[ -n "${TMUX:-}${HERDR_PANE_ID:-}${CAO_DEV_RESTART:-}${restarting/0/}" ]]; then
    # tmux/herdr 内ではネスト不可のため、ヘッドレス起動してからセッションを切り替える
    cao launch --agents "$PROFILE" --session-name "$name" --working-directory "$dir" --headless --auto-approve
    attach_or_switch "$sess"
  else
    exec cao launch --agents "$PROFILE" --session-name "$name" --working-directory "$dir" --auto-approve
  fi
fi
